# Copy to .env and fill in. .env is gitignored.
#   set -a && source .env && set +a

CONFIDO_SNOWFLAKE_ACCOUNT=your_account_locator
CONFIDO_SNOWFLAKE_USER=YOUR_USER
CONFIDO_SNOWFLAKE_ROLE=YOUR_ROLE
CONFIDO_SNOWFLAKE_SCHEMA=YOUR_DEV_SCHEMA

# dbt scrubs anything prefixed DBT_ENV_SECRET_ from its logs
DBT_ENV_SECRET_CONFIDO_SNOWFLAKE_PASSWORD=your_password
